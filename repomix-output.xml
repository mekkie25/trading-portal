def _post_sl_analysis(trades: List[Dict[str, Any]]) -> Dict[str, Any]:
    """
    §16. For every stop-loss exit, measure how far price kept moving against us
    after the stop was hit. Reported in pips (using the shared pip_size) AND in
    R units (pips / SL pips). R values above MAX_R_CAP are clamped.
    """
    sl_exits = [
        t for t in trades
        if isinstance(t, dict)
        and "SL" in str(t.get("exit_reason", ""))
        and t.get("post_sl_cont_pips") is not None
    ]

    if not sl_exits:
        return {
            "count": 0, "mean_pips": 0.0, "median_pips": 0.0, "max_pips": 0.0,
            "mean_r": 0.0, "median_r": 0.0, "max_r": 0.0,
            "recovered_count": 0, "recovered_pct": 0.0,
        }

    pips_list = []
    r_list = []

    for t in sl_exits:
        pip_size = get_pip_size(str(t.get("symbol", "")))
        entry = float(t.get("entry_price", 0.0))
        sl = float(t.get("sl", 0.0))
        sl_dist = abs(entry - sl)

        cont_pips = float(t.get("post_sl_cont_pips", 0.0) or 0.0)
        pips_list.append(cont_pips)

        if sl_dist > 0 and pip_size > 0:
            sl_pips = sl_dist / pip_size
            r_val = cont_pips / sl_pips if sl_pips > 0 else 0.0
            r_list.append(min(max(r_val, 0.0), MAX_R_CAP))

    pips_arr = np.array(pips_list, dtype=float) if pips_list else np.array([0.0])
    r_arr = np.array(r_list, dtype=float) if r_list else np.array([0.0])

    recovered = [t for t in sl_exits if t.get("recovered_to_tp", False)]

    return {
        "count": len(sl_exits),
        "mean_pips": round(float(pips_arr.mean()), 1),
        "median_pips": round(float(np.median(pips_arr)), 1),
        "max_pips": round(float(pips_arr.max()), 1),
        "mean_r": round(float(r_arr.mean()), 2),
        "median_r": round(float(np.median(r_arr)), 2),
        "max_r": round(float(r_arr.max()), 2),
        "recovered_count": len(recovered),
        "recovered_pct": round((len(recovered) / len(sl_exits)) * 100.0, 1),
    }


def _post_tp_analysis(trades: List[Dict[str, Any]]) -> Dict[str, Any]:
    """
    §17. For every take-profit exit, measure how many extra pips price moved in
    our favour after the TP was hit. Reported in pips and in R units.
    """
    tp_exits = [
        t for t in trades
        if isinstance(t, dict)
        and t.get("exit_reason") == "TP"
        and t.get("post_tp_extra_pips") is not None
    ]

    if not tp_exits:
        return {
            "count": 0, "mean_pips": 0.0, "median_pips": 0.0, "max_pips": 0.0,
            "mean_r": 0.0, "median_r": 0.0, "max_r": 0.0,
            "avg_missed_r": 0.0,
        }

    pips_list = []
    r_list = []

    for t in tp_exits:
        pip_size = get_pip_size(str(t.get("symbol", "")))
        entry = float(t.get("entry_price", 0.0))
        sl = float(t.get("sl", 0.0))
        sl_dist = abs(entry - sl)

        extra_pips = float(t.get("post_tp_extra_pips", 0.0) or 0.0)
        pips_list.append(extra_pips)

        if sl_dist > 0 and pip_size > 0:
            sl_pips = sl_dist / pip_size
            r_val = extra_pips / sl_pips if sl_pips > 0 else 0.0
            r_list.append(min(max(r_val, 0.0), MAX_R_CAP))

    pips_arr = np.array(pips_list, dtype=float) if pips_list else np.array([0.0])
    r_arr = np.array(r_list, dtype=float) if r_list else np.array([0.0])

    return {
        "count": len(tp_exits),
        "mean_pips": round(float(pips_arr.mean()), 1),
        "median_pips": round(float(np.median(pips_arr)), 1),
        "max_pips": round(float(pips_arr.max()), 1),
        "mean_r": round(float(r_arr.mean()), 2),
        "median_r": round(float(np.median(r_arr)), 2),
        "max_r": round(float(r_arr.max()), 2),
        "avg_missed_r": round(float(r_arr.mean()), 2),
    }


def _premature_be_analysis(trades):
    if not trades:
        return {"total_be_moved": 0, "premature_count": 0, "premature_pct": 0.0,
                "total_missed_r": 0.0, "avg_missed_r": 0.0}

    be_moved = [t for t in trades if t.get("is_be_moved", False)]
    premature = [t for t in be_moved if t.get("premature_be_exit", False)]

    missed = [float(t.get("missed_r_at_tp", 0.0)) for t in premature]
    total_missed = float(sum(missed)) if missed else 0.0
    avg_missed = float(np.mean(missed)) if missed else 0.0

    return {
        "total_be_moved": len(be_moved),
        "premature_count": len(premature),
        "premature_pct": round((len(premature) / len(be_moved)) * 100.0, 1) if be_moved else 0.0,
        "total_missed_r": round(total_missed, 2),
        "avg_missed_r": round(avg_missed, 2),
    }


def _ema_200_alignment(trades):
    aligned, counter, unknown = [], [], []
    for t in trades:
        a = t.get("alignment_200ema", "UNKNOWN")
        if a in ("BULLISH_ALIGNED", "BEARISH_ALIGNED"):
            aligned.append(t)
        elif a == "COUNTER_TREND":
            counter.append(t)
        else:
            unknown.append(t)
    return {"aligned": _kpis(aligned), "counter_trend": _kpis(counter), "unknown": _kpis(unknown)}


def _confirmation_type_analysis(trades):
    close, touch = [], []
    for t in trades:
        ct = str(t.get("confirmation_type", "CLOSE")).upper()
        (touch if ct == "TOUCH" else close).append(t)
    return {"close": _kpis(close), "touch": _kpis(touch)}


def _news_window_analysis(trades):
    in_news, out_news = [], []
    for t in trades:
        (in_news if t.get("is_in_news_window", False) else out_news).append(t)
    return {"in_news": _kpis(in_news), "out_of_news": _kpis(out_news)}


