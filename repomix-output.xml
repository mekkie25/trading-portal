            "USDJPY": {"standard": 0.012, "max_allowed": 0.025},
            "GBPUSD": {"standard": 0.00014, "max_allowed": 0.00030}
        }

        self.SECTOR_MAP = {
            "US30": "EQUITY_INDEX",
            "NAS100": "EQUITY_INDEX",
            "GERMAN30": "EQUITY_INDEX",
            "GOLD": "PRECIOUS_METAL",
            "EURUSD": "FOREX_MAJORS",
