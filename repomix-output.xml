                              <td className="py-1.5 px-2 text-slate-600 dark:text-slate-300">{tr.strategy || ''}</td>
                              <td className={`py-1.5 px-2 font-bold ${tr.direction === 'BUY' ? 'text-emerald-500' : 'text-rose-500'}`}>
                                {tr.direction}
