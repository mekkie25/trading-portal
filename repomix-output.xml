                yearFilter === y
                  ? 'bg-blue-600 text-white border-blue-600'
                  : 'bg-white dark:bg-[#08090d] text-slate-600 dark:text-slate-300 border-slate-300 dark:border-[#1a2030] hover:border-slate-400'
