                    <td className="py-3.5 px-4 font-mono font-bold">
                      <span className={(trade.pnl || 0) >= 0 ? 'text-emerald-700 dark:text-emerald-400' : 'text-rose-600'}>
                        {formatCurrency(trade.pnl || 0, brokerConfig.currency)}
                      </span>
