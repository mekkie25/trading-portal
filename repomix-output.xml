              >
                {copyStatus === 'copied' ? <Check className="w-3.5 h-3.5" /> : <Copy className="w-3.5 h-3.5" />}
                <span>{copyStatus === 'copied' ? 'Copied' : 'Copy for AI'}</span>
              </button>

              <button
